  "info": {
    "_postman_id": "85bc33fd-288c-4b61-8439-ea439462735c",
    "name": "Amazon EC2 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Amazon EC2 API is a query API for managing EC2 compute, EBS volumes,\nand VPC resources. It is transported over HTTPS to a regional EC2 endpoint,\nand requests are signed using AWS Signature v4. This OpenAPI captures a\nrepresentative subset of operations as an API Evangelist research artifact\nfor the scalable-infrastructure topic.\n\n\nContact Support:\n Name: API Evangelist",
      "type": "text/plain"
    }
  }
